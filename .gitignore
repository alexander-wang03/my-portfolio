# Dependencies
/node_modules
package-lock.json.bak

# Build output
#
# Vite writes here on every build, with a content hash in each filename — so
# tracking it means every build rewrites the same files under new names and
# the diff fills with churn. Deploys build from source (Vercel, Netlify and
# GitHub Actions all do); the only setup that would need this committed is
# GitHub Pages serving a branch, which can only serve / or /docs anyway.
/dist

# Editor and OS
.DS_Store
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo
